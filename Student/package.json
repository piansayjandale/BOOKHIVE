{
  "name": "bookhive-student-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:lan": "expo start --go --lan",
    "start:offline": "expo start --go --offline",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "ts:check": "tsc",
    "build:apk": "eas build -p android --profile preview",
    "build:apk:local": "eas build -p android --profile preview --local",
    "build:ios": "eas build -p ios --profile preview-device",
    "build:ios:sim": "eas build -p ios --profile preview",
    "build:ios:prod": "eas build -p ios --profile production",
    "build:ios:local": "eas build -p ios --profile preview --local",
    "prebuild": "expo prebuild --clean",
    "login": "expo login",
    "whoami": "expo whoami",
    "logout": "expo logout"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.16.1",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.9",
    "expo-image-loader": "~58.0.3",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.28.6",
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@babel/plugin-transform-private-property-in-object": "^7.28.6",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "typescript": "~6.0.3"
  },
  "private": true
}
