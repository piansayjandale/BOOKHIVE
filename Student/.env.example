# ==============================================================================
# BookHive Student Mobile App - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# When compiling release APKs (via EAS Build), set EXPO_PUBLIC_API_URL in eas.json
# or pass it as an environment secret.
#
# DEVELOPMENT DEFAULT: Localhost (http://localhost:5000 or dynamic Wi-Fi hostUri)
# PRODUCTION TARGET: Live Render Backend (https://bookhive-backend.onrender.com)
# ==============================================================================

# Backend API Base URL for Mobile Application
# - Local Development Default (iOS Simulator, Web, Metro):
EXPO_PUBLIC_API_URL=http://localhost:5000

# - Android Emulator (loopback to host development machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000

# - Physical Mobile Device over local Wi-Fi (replace with your computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000

# - Standalone Android APK / Production Release:
# EXPO_PUBLIC_API_URL=https://bookhive-backend.onrender.com

# ------------------------------------------------------------------------------
# Granular Local Development Overrides
# ------------------------------------------------------------------------------
# Android Emulator loopback fallback
EXPO_PUBLIC_EMULATOR_URL=http://10.0.2.2:5000

# Local development fallback
EXPO_PUBLIC_LOCAL_DEV_URL=http://localhost:5000

# Default port for local backend communication
EXPO_PUBLIC_API_PORT=5000
