# ==============================================================================
# BookHive Unified Workspace - Root Environment Configuration Template
# ==============================================================================
# This root file documents environment variables across the entire BookHive
# ecosystem (Backend API, Librarian & Admin Next.js Web App, and Student Mobile App).
#
# DEVELOPMENT DEFAULT: Localhost (127.0.0.1:5432, Express: port 5000, Next.js: port 3000)
# PRODUCTION TARGET: Render Free Tier Web Services & Managed PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express Backend Service (Render Service: bookhive-backend)
# ------------------------------------------------------------------------------
# Server port (Defaults to 5000 in development; Render dynamically injects PORT)
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Single Source of Truth)
# - Local Development:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bookhive_2nd
# - Production on Render (Internal Connection String provided by Render Database):
# DATABASE_URL=postgresql://bookhive_user:YOUR_DB_PASSWORD@dpg-xxxxxx-a/bookhive_db
# - Production on Render (External Connection String for external migration/access):
# DATABASE_URL=postgresql://bookhive_user:YOUR_DB_PASSWORD@dpg-xxxxxx-a.oregon-postgres.render.com/bookhive_db

# JWT & Authentication Secrets (Must match across Backend & Web Frontend)
JWT_SECRET=development_jwt_secret_key_change_in_production
BOOKHIVE_JWT_SECRET=development_jwt_secret_key_change_in_production

# Allowed Web Frontend Origins & Redirect Targets for CORS
# - Local Development:
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# - Production on Render:
# CORS_ORIGIN=https://bookhive-frontend.onrender.com
# FRONTEND_URL=https://bookhive-frontend.onrender.com

# (Optional) Google Gemini API Key for OCR validation & semantic search
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Librarian & Admin Web Frontend (Render Service: bookhive-frontend)
# ------------------------------------------------------------------------------
# Target API URL used by Next.js client & server-side proxy
# - Local Development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# - Production on Render:
# NEXT_PUBLIC_API_URL=https://bookhive-backend.onrender.com/api

# Next.js Session Secret (minimum 32 characters)
SESSION_SECRET=development_session_secret_key_min_32_characters_long
NEXT_PUBLIC_APP_NAME=BookHive Management

# ------------------------------------------------------------------------------
# 3. Student Mobile Companion App (Expo / React Native / Standalone APK)
# ------------------------------------------------------------------------------
# Base API URL consumed by the mobile app (services/api.ts)
# - Local Development (iOS Simulator / Web):
EXPO_PUBLIC_API_URL=http://localhost:5000
# - Local Development (Android Emulator):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# - Local Development (Physical Device on Wi-Fi):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:5000
# - Production EAS Build / Release APK:
# EXPO_PUBLIC_API_URL=https://bookhive-backend.onrender.com

EXPO_PUBLIC_EMULATOR_URL=http://10.0.2.2:5000
EXPO_PUBLIC_LOCAL_DEV_URL=http://localhost:5000
EXPO_PUBLIC_API_PORT=5000
