# ==============================================================================
# BookHive Backend - Environment Configuration Template
# ==============================================================================

# Application Port (Render automatically supplies PORT in production, default for local dev: 5000)
PORT=5000

# Environment mode: 'development' | 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database Configuration (Single Source of Truth)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
#
# SSL Behavior (Automatic & Dynamic in connection-config.js):
# - Localhost / 127.0.0.1: SSL is automatically DISABLED (rejectUnauthorized: false is NOT sent).
# - Remote / Cloud (Render, Supabase, Neon, AWS RDS): SSL is automatically ENABLED ({ rejectUnauthorized: false }).
#
# Localhost Default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bookhive_2nd

# Production on Render Examples:
# - Internal Database URL (recommended when backend & DB run in the same Render region):
# DATABASE_URL=postgresql://bookhive_user:secret123@dpg-c123456789-a/bookhive_db
#
# - External Database URL (for local migrations or connecting from outside Render):
# DATABASE_URL=postgresql://bookhive_user:secret123@dpg-c123456789-a.oregon-postgres.render.com/bookhive_db
#
# - Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb

# (Optional) Explicit SSL override: 'true' | 'false' (leave unset for automatic detection)
# DB_SSL=true

# (Optional) Connection Pool Tuning (Defaults: Timeout 10000ms, Max Connections 10)
DB_CONNECTION_TIMEOUT_MS=10000
DB_MAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (JWT)
# IMPORTANT: In production, generate a secure random string (minimum 32 characters)
JWT_SECRET=development_jwt_secret_key_change_in_production
BOOKHIVE_JWT_SECRET=development_jwt_secret_key_change_in_production

# Allowed origins for CORS (supports comma-separated URLs or single URL)
# - Local Development:
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# - Production on Render:
# CORS_ORIGIN=https://bookhive-frontend.onrender.com
# FRONTEND_URL=https://bookhive-frontend.onrender.com

# ------------------------------------------------------------------------------
# AI Services (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key for AI-driven book search, summaries, and OCR validation
GEMINI_API_KEY=your_gemini_api_key_here
