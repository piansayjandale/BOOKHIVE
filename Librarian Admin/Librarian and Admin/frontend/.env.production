# ==============================================================================
# BookHive Web Frontend - Production Environment (.env.production)
# Configure these variables in your Render Web Dashboard for the Frontend Service
# ==============================================================================

# Backend API Endpoint
# If using a Custom Domain (e.g., api.yourdomain.com):
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# If using Render default subdomains:
# NEXT_PUBLIC_API_URL=https://bookhive-backend.onrender.com/api

# Production Cloud Database (Render Postgres / Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Authentication & Session Secrets (JWT_SECRET must match the Backend JWT_SECRET)
JWT_SECRET=your_production_jwt_secret_must_match_backend
BOOKHIVE_JWT_SECRET=your_production_jwt_secret_must_match_backend
SESSION_SECRET=your_production_session_cookie_secret_min_32_chars

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=BookHive Management
