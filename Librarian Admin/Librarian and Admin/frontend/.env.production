# ==============================================================================
# BookHive Web Frontend - Production Environment (.env.production)
# Set sensitive secrets (DATABASE_URL, JWT_SECRET, BOOKHIVE_JWT_SECRET, GEMINI_API_KEY)
# in your Vercel Project Environment Variables dashboard.
# ==============================================================================

# Production Backend API Endpoint (override in Vercel if using a custom API domain)
NEXT_PUBLIC_API_URL=https://bookhive-backend.onrender.com/api

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=BookHive Management
