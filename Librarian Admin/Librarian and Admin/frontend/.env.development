# ==============================================================================
# BookHive Web Frontend - Local Development Environment (.env.development)
# ==============================================================================

# Backend API Endpoint (points to local Express backend on port 5000)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Local PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bookhive_2nd

# Authentication Secrets
JWT_SECRET=development_jwt_secret_key_2026
BOOKHIVE_JWT_SECRET=development_jwt_secret_key_2026
SESSION_SECRET=development_session_secret_key_2026

# App Details
NEXT_PUBLIC_APP_NAME=BookHive Monitor
PORT=3000
