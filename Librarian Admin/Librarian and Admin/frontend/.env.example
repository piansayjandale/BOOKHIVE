# ==============================================================================
# BookHive Web Frontend (Librarian & Admin) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production on Render, configure these environment variables in your Render Dashboard.
#
# DEVELOPMENT DEFAULT: Local Express API on port 5000, Local PostgreSQL on 127.0.0.1
# PRODUCTION TARGET: Render Backend Web Service (https://bookhive-backend.onrender.com/api)
# ==============================================================================

# Backend API Endpoint
# - Local Development:
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# - Production on Render:
# NEXT_PUBLIC_API_URL=https://bookhive-backend.onrender.com/api

# PostgreSQL Database Connection URL (Optional direct connection for admin scripts / queries)
# - Local Development:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bookhive_2nd
# - Production on Render (Internal Database Connection String from bookhive-db):
# DATABASE_URL=postgresql://bookhive_user:secret123@dpg-xxxxxx-a/bookhive_db

# Authentication Secrets (JWT_SECRET must match the Express Backend JWT_SECRET)
JWT_SECRET=development_jwt_secret_key_change_in_production
BOOKHIVE_JWT_SECRET=development_jwt_secret_key_change_in_production
SESSION_SECRET=development_session_secret_cookie_key_min_32_chars

# Application Environment & Identity
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=BookHive Management
PORT=3000

# Next.js Allowed Development Origins (for LAN / Multi-device testing)
ALLOWED_DEV_ORIGINS=192.168.1.28,localhost:3000

# (Optional) Google Gemini API Key for semantic catalog search
GEMINI_API_KEY=your_gemini_api_key_here
